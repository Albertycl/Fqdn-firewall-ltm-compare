# Copy to .env and adjust per deployment. Every value has a working default.

# Database
# Leave DB_HOST unset (or "db") to run the bundled MariaDB container.
# To use a database you already run, point these at it — for one on this host,
# use host.docker.internal with the port it publishes:
#   DB_HOST=host.docker.internal
#   DB_PORT=3307
DB_HOST=db
DB_PORT=3306
DB_USER=root
# Required: choose your own password (there is no default).
DB_PASSWORD=
DB_NAME=fqdn_tool

# Published host ports
DB_PUBLISHED_PORT=3307
BACKEND_PUBLISHED_PORT=5432
FRONTEND_PUBLISHED_PORT=5434

# Supplementary FQDN tables (fqdn_new, slbs) in the database FQDN_DB_NAME.
# Host, user and password default to the DB_* values above. Load the demo rows with
# demo/seed_fqdn_demo.sql. Set FQDN_DB_ENABLED=false to switch the lookup off.
FQDN_DB_ENABLED=true
FQDN_DB_NAME=fqdn_v3
FQDN_DB_TIMEOUT=3
FQDN_DB_COOLDOWN=60

# Where device configs are fetched from
CONFIG_SOURCE_URL=http://config-server.example/configs/

# Hour (0-23, local TZ) for the in-stack daily update
DAILY_UPDATE_HOUR=6
TZ=Asia/Taipei

# Set only if this host needs a proxy for external access. The config
# server must be listed in NO_PROXY or downloads will be refused with 403.
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,db
